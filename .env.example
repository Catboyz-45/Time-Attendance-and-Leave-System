# คัดลอกไฟล์นี้เป็น .env แล้วเปลี่ยนรหัสผ่านทุกค่าก่อนใช้งานจริง:  cp .env.example .env
# ห้าม commit ไฟล์ .env ขึ้น git (อยู่ใน .gitignore แล้ว)

# รหัสผ่าน root ของ MySQL (ใช้สำหรับดูแลฐานข้อมูลและสำรองข้อมูลเท่านั้น)
DB_ROOT_PASSWORD=change-me-root-password

# บัญชีฐานข้อมูลที่แอปใช้ (มีสิทธิ์เฉพาะฐานข้อมูล webdb ไม่ใช่ root)
DB_USER=tals
DB_PASSWORD=change-me-app-password

# ใช้เซ็น cookie ของ session: ตั้งเป็นข้อความสุ่มยาวๆ เช่นผลจากคำสั่ง  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# บัญชีผู้ดูแลระบบคนแรก (สร้างให้อัตโนมัติเมื่อยังไม่มีผู้ใช้ในระบบ)
# ถ้าไม่ตั้ง ADMIN_PASSWORD ระบบจะสุ่มรหัสผ่านชั่วคราวและแสดงใน log:  docker compose logs app
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# พอร์ตของหน้าเว็บ (เปิดให้เครื่องอื่นในเครือข่ายเข้าได้ที่ http://<IP เครื่องนี้>:3000)
APP_PORT=3000

# ออกจากระบบอัตโนมัติเมื่อไม่ได้ใช้งานกี่ชั่วโมง
SESSION_HOURS=8

# ตั้งเป็น true เมื่อเปิดใช้งานผ่าน HTTPS (เช่น อยู่หลัง reverse proxy ที่มีใบรับรอง)
COOKIE_SECURE=false
TRUST_PROXY=false
